<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BrandNavy">#0E2D58</Color>
    <Color x:Key="BrandBlue">#153F78</Color>
    <Color x:Key="BrandBlueLight">#1D4D8D</Color>
    <Color x:Key="BrandYellow">#F5C518</Color>
    <Color x:Key="PageBackground">#F3F4F7</Color>
    <Color x:Key="TextPrimary">#102A43</Color>
    <Color x:Key="SuccessBackground">#E8F3ED</Color>
    <Color x:Key="SuccessForeground">#28734A</Color>
    <Color x:Key="WarningBackground">#FFF8DE</Color>
    <Color x:Key="WarningForeground">#6B4E00</Color>
    <Color x:Key="ErrorBackground">#FDEBE7</Color>
    <Color x:Key="ErrorForeground">#9A3E34</Color>

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackground}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlue}" />
    <SolidColorBrush x:Key="BrandYellowBrush" Color="{StaticResource BrandYellow}" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackground}" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="{StaticResource SuccessForeground}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackground}" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="{StaticResource WarningForeground}" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackground}" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="{StaticResource ErrorForeground}" />

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource BrandNavy}" Offset="0" />
        <GradientStop Color="{StaticResource BrandBlue}" Offset="0.55" />
        <GradientStop Color="{StaticResource BrandBlueLight}" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="MinWidth" Value="960" />
        <Setter Property="MinHeight" Value="680" />
        <Setter Property="WindowState" Value="Maximized" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandBlueBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="NextActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrandYellowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
</ResourceDictionary>
