<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="__APP_TITLE__"
        Icon="Assets/icone.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/BrandTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="78" Height="78" CornerRadius="18" Background="White">
                    <Image x:Name="BrandLogo" Source="Assets/icone.png" Margin="8" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="APP INTERFACE" Foreground="{StaticResource BrandYellowBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="__APP_TITLE__" Foreground="White" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="__APP_SUBTITLE__" Foreground="#D7E7FF" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusTitle" Text="Pronto" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="StatusDetail" Text="Aguardando início" Foreground="#D7E7FF" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="ActionsContent" Grid.Column="0" />
            <ContentControl x:Name="ResultContent" Grid.Column="2" />
        </Grid>
    </Grid>
</Window>
