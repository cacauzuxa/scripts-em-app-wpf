<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="__APP_TITLE__"
        Icon="Assets/icone.ico"
        MinWidth="960"
        MinHeight="680"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/BrandTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="78" Height="78" CornerRadius="18" Background="White">
                    <Image x:Name="BrandLogo" Source="Assets/icone.png" Margin="8" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="APP INTERFACE" Foreground="{StaticResource BrandCyanBrush}" FontWeight="SemiBold" />
                    <TextBlock x:Name="AppTitleText" Text="Aplicativo WPF" Foreground="White" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="AppSubtitleText" Text="Interface pronta para conectar um fluxo existente." Foreground="#D7E7FF" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusTitle" Text="Pronto" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="StatusDetail" Text="Aguardando início" Foreground="#D7E7FF" HorizontalAlignment="Right" />
                    <ProgressBar x:Name="OverallProgress" Minimum="0" Maximum="100" Value="0"
                                 Width="190" Height="7" Margin="0,10,0,0"
                                 Foreground="{StaticResource BrandCyanBrush}"
                                 Background="#5577A4"
                                 IsIndeterminate="False" />
                    <TextBlock x:Name="ProgressText" Text="0% · Não iniciado"
                               Foreground="{StaticResource BrandCyanBrush}" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <ContentControl x:Name="ActionsContent" />
            </ScrollViewer>
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <ContentControl x:Name="ResultContent" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
